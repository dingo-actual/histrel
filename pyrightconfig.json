{
    "include": ["src", "benchmark"],
    "exclude": [
        "**/handbook",
        "**/scratch",
        "**/resources",
        "**/vendor/*",
        "**/benchmark/vendor/*",
        "**/.venv*",
        "**/venv*",
        "**/build",
        "**/dist",
        "**/.hypothesis",
        "**/.mypy_cache",
        "**/.pytest_cache",
        "**/.ruff_cache",
        "**/.serena",
        "**/.srclight",
        "**/.vscode",
        "**/_build",
        "**/assets",
        "**/benchmark/results/*",
        "**/debug/logs",
        "**/docs",
        "**/scripts/tmp",
        "**/__pycache__",
        "**/.git",
        "**/.hg",
        "**/.svn",
        "**/.mypy_cache",
        "**/node_modules",
        "**/data",
        "**/logs",
        "**/*.md",
        "**/*.json",
        "!**/*.py"
    ],
    "ignore": ["tests"],
    "typeCheckingMode": "standard",
    "pythonVersion": "3.11",
    "extraPaths": ["src", "benchmark/vendor/SWE-bench"],
    "reportMissingImports": "error",
    "reportMissingTypeStubs": false
}
